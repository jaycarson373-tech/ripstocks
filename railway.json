{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.worker",
    "watchPatterns": ["worker/**", "config/**", "Dockerfile.worker", "package.json", "package-lock.json", "railway.json"]
  },
  "deploy": {
    "startCommand": "node worker/treasury-worker.mjs",
    "drainingSeconds": 180,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
