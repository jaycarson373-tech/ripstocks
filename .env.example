# =========================
# Vercel public/client config
# =========================
# Safe for the browser. Do not put private keys or service-role keys here.
NEXT_PUBLIC_RAILWAY_API_URL=https://your-service.up.railway.app
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your-key
NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta
NEXT_PUBLIC_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
NEXT_PUBLIC_MAIN_TREASURY_WALLET=public-address-for-wallet-1
NEXT_PUBLIC_HOLDER_AIRDROP_WALLET=public-address-for-wallet-2
NEXT_PUBLIC_STOCKDROPS_MINT=GUmtbfXHEKyB1SwpyevMHwXa9nx2LT9gKD1a738Vpump
NEXT_PUBLIC_X_URL=https://x.com/StockDrops

# Optional Vercel server-side gate. No NEXT_PUBLIC_ prefix.
# Keep false until the draw worker has shipped and passed dry-run.
DRAWS_LIVE=false

# =========================
# Railway server config
# =========================
# Never prefix secrets with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your-key
SOLANA_NETWORK=mainnet-beta
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
MAIN_TREASURY_WALLET=public-address-for-wallet-1
HOLDER_AIRDROP_WALLET=public-address-for-wallet-2
# Token whose positive-balance owners are eligible for synchronized holder drops.
HOLDER_TOKEN_MINT=GUmtbfXHEKyB1SwpyevMHwXa9nx2LT9gKD1a738Vpump
# DROPS ticket math. Every 250,000 whole tokens equals one weighted ticket.
HOLDER_TICKET_TOKENS=250000
STOCKDROPS_TOKEN_DECIMALS=6
DRAWS_LIVE=false

# =========================
# Railway private key section
# =========================
# Required only for services that actually sign transactions.
# Use Railway secret variables. Never add these to Vercel, GitHub, or browser env.
# Expected value: the base58/JSON secret format accepted by lib/server-config.ts.
MAIN_TREASURY_SIGNER_SECRET=railway-only-secret
HOLDER_AIRDROP_SIGNER_SECRET=railway-only-secret

# =========================
# Railway swap/restock config
# =========================
JUPITER_API_KEY=your-jupiter-api-key
JUPITER_SLIPPAGE_BPS=100
# Only verified xStock mints. Each enabled target can become a $1-$30 inventory lot.
# Example shape: [{"symbol":"AAPLx","mint":"...","enabled":true,"weight":1}]
XSTOCK_TARGETS_JSON=[{"symbol":"CRCLx","mint":"XsueG8BtpquVJX9LVLLEGuViXUungE6WmK5YZ3p3bd1","enabled":true,"weight":1},{"symbol":"SPYx","mint":"XsoCS1TfEyfFhfvj8EtZ528L3CaKBDBRqRapnBbDF2W","enabled":true,"weight":1},{"symbol":"QQQx","mint":"Xs8S1uUs1zvS2p7iwtsG3b6fkhpvmwz4GYU3gWAmWHZ","enabled":true,"weight":1},{"symbol":"TSLAx","mint":"XsDoVfqeBukxuZHWhdvWHBhgEHjGNst4MLodqsJHzoB","enabled":true,"weight":1},{"symbol":"MSTRx","mint":"XsP7xzNPvEHS1m6qfanPUGjNmdnmsLKEoNAnHjdxxyZ","enabled":true,"weight":1},{"symbol":"NVDAx","mint":"Xsc9qvGR1efVDFGLrVsmkzv3qi45LTBjeUKSPmx9qEh","enabled":true,"weight":1},{"symbol":"COINx","mint":"Xs7ZdzSHLU9ftNJsii5fCeJhoRWSC32SQGzGQtePxNu","enabled":true,"weight":1},{"symbol":"GOOGLx","mint":"XsCPL9dNWBMvFtTmwcCA5v3xWPSMEBCszbQdiLLq6aN","enabled":true,"weight":1},{"symbol":"HOODx","mint":"XsvNBAYkrDRNhA7wPHQfX3ZUXZyZLdnCQDfHZ56bzpg","enabled":true,"weight":1},{"symbol":"AMZNx","mint":"Xs3eBt7uRfJX8QUs4suhyU8p2M6DoUDrJyWBa8LLZsg","enabled":true,"weight":1}]
# Protect Railway scheduler/admin routes. Generate a long random value.
AUTOMATION_SECRET=your-long-random-secret
# Public URL of the normal Railway web service, used by the small cron service.
RAILWAY_API_URL=https://your-service.up.railway.app
# Railway injects RAILWAY_PUBLIC_DOMAIN automatically. The normal service uses
# it to run idempotent 5-minute automation without a second cron service.
SOL_GAS_BUFFER=0.111
MAIN_INVENTORY_BUDGET_USD=150
HOLDER_INVENTORY_BUDGET_USD=100
