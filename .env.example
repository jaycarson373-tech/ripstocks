# Public browser configuration
NEXT_PUBLIC_SITE_URL=https://www.stonkdrops.fun
NEXT_PUBLIC_STONKRIPS_CONTRACT=
NEXT_PUBLIC_PONS_TOKEN_URL=
NEXT_PUBLIC_X_URL=

# Server-only launch gate. Keep false until the contract is deployed, tested,
# enabled on-chain, and loaded with funded Stock Token inventory.
PACKS_LIVE=false
AUTOMATION_PUBLIC_LIVE=false

# Server-side Robinhood Chain RPC used for truthful inventory status.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Railway-only Pons v2 automation. Start with off, then use dry-run before live.
AUTOMATION_MODE=off
AUTOMATION_PRIVATE_KEY=
PONS_TOKEN_ADDRESS=
# Optional override. Leave empty to discover the token deployment block on-chain.
PONS_TOKEN_START_BLOCK=
STOCKRIPS_PACK_CONTRACT=
PACK_CONTRACT_START_BLOCK=

# Pons v2 Robinhood Chain contracts and the intended SPY quote asset.
PONS_V2_FACTORY=0xA5aAb3F0c6EeadF30Ef1D3Eb997108E976351feB
PONS_FEE_LOCKER=0x736D76699C26D0d966744cAe304C000d471f7F35
PONS_QUOTE_TOKEN=0x117cc2133c37B721F49dE2A7a74833232B3B4C0C

# 0x Swap API. The account must be explicitly approved for Robinhood RWA routing.
ZEROX_API_KEY=
ZEROX_SLIPPAGE_BPS=100

# Server-side audit database. Never expose the service-role key to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# One hourly cycle: 50% direct holder Stock Token drop, 50% pack inventory.
DROP_INTERVAL_MINUTES=60
FEE_SPLIT_BPS=5000
TOKENS_PER_TICKET=250000
WORKER_POLL_SECONDS=60
HOLDER_LOG_CHUNK_SIZE=2000
HOLDER_EXCLUDE_ADDRESSES=
